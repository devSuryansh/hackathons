# Caspian
CASPIAN_API_KEY=
CASPIAN_BASE_URL=https://api.trycaspianai.com
EMAIL_USERNAME=myclone

# Channels (human-created tokens — see GUIDE.md)
TELEGRAM_BOT_TOKEN=
DISCORD_BOT_TOKEN=

# Owner handles for /pause /resume /status
# Caspian Telegram/Discord payloads use USERNAMES (not numeric ids). Prefer these:
OWNER_TELEGRAM_USERNAME=
OWNER_DISCORD_USERNAME=
OWNER_EMAIL=
# Optional fallbacks if a numeric id ever appears:
OWNER_TELEGRAM_ID=
OWNER_DISCORD_ID=

# Featherless inference
FEATHERLESS_API_KEY=
FEATHERLESS_MODEL=Qwen/Qwen2.5-7B-Instruct

# Dashboard
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8787
CLONE_DB_PATH=data/clone.db
